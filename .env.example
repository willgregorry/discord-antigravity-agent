# ===============================================================
# Antigravity Discord Agent - Environment Configuration Template
# ===============================================================

# 1. Discord Bot Token (Dapatkan di https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# 2. Gemini API Key (Opsional - jika menggunakan direct Gemini SDK)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Default Working Directory jika channel belum dipetakan
# Contoh Windows: C:\Users\Username\Projects
# Contoh Linux/Mac: /home/username/projects
DEFAULT_DIR=C:\Users\YourUsername\Projects

# 4. Keamanan: Daftar Discord User ID yang diizinkan mengontrol bot
# Pisahkan dengan koma jika lebih dari 1 ID (contoh: 123456789012345678,987654321098765432)
# Biarkan kosong jika bot berada di server pribadi yang hanya kamu sendiri
ALLOWED_USER_IDS=your_discord_user_id

# 5. Path Eksekutabel Antigravity CLI (Opsional)
# Biarkan kosong jika agy sudah ada di PATH atau terpasang di lokasi standar Windows (%LOCALAPPDATA%\agy\bin\agy.exe)
AGY_PATH=

# 6. Path Sertifikat SSL Antigravity Language Server (Opsional - untuk kuota monitoring)
ANTIGRAVITY_CERT_PATH=
